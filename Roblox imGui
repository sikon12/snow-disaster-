    btn.BackgroundColor3 = Color3.new(0.21,0.33,0.55)
    btn.TextColor3 = Color3.new(1,1,1)
    btn.MouseButton1Click:Connect(callback)
    btn.Parent = ScrollContent
    LayoutY += 30
end

local function AddInput(hint,bindTable,key)
    local box = Instance.new("TextBox")
    box.PlaceholderText = hint
    box.Text = bindTable[key]
    box.Font = Enum.Font.Gotham
    box.TextSize = 12
    box.Size = UDim2.new(1,0,0,26)
    box.Position = UDim2.new(0,0,0,LayoutY)
    box.BackgroundColor3 = Color3.new(0.05,0.05,0.07)
    box.BorderColor3 = Color3.new(0.36,0.36,0.42)
    box.TextColor3 = Color3.new(1,1,1)
    box.FocusLost:Connect(function(t) bindTable[key] = t end)
    box.Parent = ScrollContent
    LayoutY += 30
end

-- Draw dynamic tab bar from ImGuiIO.Tabs
local function DrawTabBar()
    TabBarFrame:ClearAllChildren()
    local tabCount = #ImGuiIO.Tabs
    local tabWidth = 1/tabCount
    for i,tabData in ipairs(ImGuiIO.Tabs) do
        local tabBtn = Instance.new("TextButton")
        tabBtn.Text = tabData.Name
        tabBtn.Font = Enum.Font.Gotham
        tabBtn.TextSize = 11
        tabBtn.Size = UDim2.new(tabWidth,-2,1,-2)
        tabBtn.Position = UDim2.new((i-1)*tabWidth,1,0,1)
        tabBtn.BackgroundColor3 = ImGuiIO.ActiveTabIndex == i and Color3.new(0.25,0.43,0.87) or Color3.new(0.18,0.18,0.22)
        tabBtn.TextColor3 = Color3.new(1,1,1)
        tabBtn.MouseButton1Click:Connect(function() ImGuiIO.ActiveTabIndex = i end)
        tabBtn.Parent = TabBarFrame
    end
end

-- Window Drag & Resize Logic
TitleBar.InputBegan:Connect(function(i)
    if i.UserInputType == Enum.UserInputType.MouseButton1 then ImGuiIO.DragActive = UserInputService:GetMouseLocation() end
end)
ResizeHandle.InputBegan:Connect(function(i)
    if i.UserInputType == Enum.UserInputType.MouseButton1 then ImGuiIO.ResizeActive = UserInputService:GetMouseLocation() end
end)
UserInputService.InputChanged:Connect(function(i)
    local m = UserInputService:GetMouseLocation()
    if ImGuiIO.DragActive and i.UserInputType == Enum.UserInputType.MouseMovement then
        local d = m - ImGuiIO.DragActive
        ImGuiIO.WindowPos += UDim2.new(0,d.X,0,d.Y)
        WinFrame.Position = ImGuiIO.WindowPos
        ImGuiIO.DragActive = m
    end
    if ImGuiIO.ResizeActive and i.UserInputType == Enum.UserInputType.MouseMovement then
        local d = m - ImGuiIO.ResizeActive
        local nw = math.max(ImGuiIO.WindowSize.X.Offset + d.X, ImGuiIO.MinSize.X)
        local nh = math.max(ImGuiIO.WindowSize.Y.Offset + d.Y, ImGuiIO.MinSize.Y)
        ImGuiIO.WindowSize = UDim2.new(0,nw,0,nh)
        WinFrame.Size = ImGuiIO.WindowSize
        ImGuiIO.ResizeActive = m
    end
end)
UserInputService.InputEnded:Connect(function(i)
    if i.UserInputType == Enum.UserInputType.MouseButton1 then
        ImGuiIO.DragActive = nil
        ImGuiIO.ResizeActive = nil
    end
end)
MinBtn.MouseButton1Click:Connect(function() ImGuiIO.WindowSize = UDim2.new(0,420,0,120) WinFrame.Size = ImGuiIO.WindowSize end)
CloseBtn.MouseButton1Click:Connect(function() ImGuiIO.WindowVisible = not ImGuiIO.WindowVisible WinFrame.Visible = ImGuiIO.WindowVisible end)

