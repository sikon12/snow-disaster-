local function CreateTextLabel(text)
    local lbl=Instance.new("TextLabel")
    lbl.Text=text
    lbl.Font=Enum.Font.Gotham
    lbl.TextSize=13
    lbl.Size=UDim2.new(1,0,0,20)
    lbl.Position=UDim2.new(0,0,0,LayoutY)
    lbl.BackgroundTransparency=1
    lbl.TextColor3=Color3.new(0.94,0.94,0.94)
    lbl.Parent=ScrollContent
    LayoutY=LayoutY+26
end

local function CreateNormalButton(title,callback)
    local btn=Instance.new("TextButton")
    btn.Text=title
    btn.Font=Enum.Font.Gotham
    btn.TextSize=12
    btn.Size=UDim2.new(1,0,0,24)
    btn.Position=UDim2.new(0,0,0,LayoutY)
    btn.BackgroundColor3=Color3.new(ImGuiCore.ButtonColor[1],ImGuiCore.ButtonColor[2],ImGuiCore.ButtonColor[3])
    btn.TextColor3=Color3.new(1,1,1)
    btn.MouseButton1Click:Connect(callback)
    btn.Parent=ScrollContent
    local BtnCorner=Instance.new("UICorner")
    BtnCorner.CornerRadius=4
    BtnCorner.Parent=btn
    LayoutY=LayoutY+30
end

local function CreateIconToggle(title,icon,defaultVal,callback)
    local key=title..icon
    ImGuiCore.WidgetStorage[key]=ImGuiCore.WidgetStorage[key]==nil and defaultVal or ImGuiCore.WidgetStorage[key]
    local state=ImGuiCore.WidgetStorage[key]
    CreateTextLabel("["..icon.."] "..title.." : "..tostring(state))
    local toggleBtn=Instance.new("TextButton")
    toggleBtn.Text=state and "开启" or "关闭"
    toggleBtn.Font=Enum.Font.Gotham
    toggleBtn.TextSize=12
    toggleBtn.Size=UDim2.new(1,0,0,24)
    toggleBtn.Position=UDim2.new(0,0,0,LayoutY-26)
    toggleBtn.BackgroundColor3=state and Color3.new(ImGuiCore.ToggleOnColor[1],ImGuiCore.ToggleOnColor[2],ImGuiCore.ToggleOnColor[3]) or Color3.new(ImGuiCore.ToggleOffColor[1],ImGuiCore.ToggleOffColor[2],ImGuiCore.ToggleOffColor[3])
    toggleBtn.TextColor3=Color3.new(1,1,1)
    toggleBtn.MouseButton1Click:Connect(function()
        ImGuiCore.WidgetStorage[key]=not ImGuiCore.WidgetStorage[key]
        callback(ImGuiCore.WidgetStorage[key])
    end)
    toggleBtn.Parent=ScrollContent
    local ToggleCorner=Instance.new("UICorner")
    ToggleCorner.CornerRadius=4
    ToggleCorner.Parent=toggleBtn
end

local function RenderTabBar()
    TabBarFrame:ClearAllChildren()
    local tabCount=#ImGuiCore.TabList
    if tabCount==0 then return end
    local singleTabWidth=1/tabCount
    for i,tabObj in ipairs(ImGuiCore.TabList)do
        local tabBtn=Instance.new("TextButton")
        tabBtn.Text=tabObj.Title
        tabBtn.Font=Enum.Font.Gotham
        tabBtn.TextSize=11
        tabBtn.Size=UDim2.new(singleTabWidth,-2,1,-2)
        tabBtn.Position=UDim2.new((i-1)*singleTabWidth,1,0,1)
        tabBtn.BackgroundColor3=ImGuiCore.ActiveTab==tabObj and Color3.new(0.25,0.43,0.87) or Color3.new(0.18,0.18,0.22)
        tabBtn.TextColor3=Color3.new(1,1,1)
        tabBtn.MouseButton1Click:Connect(function() ImGuiCore.ActiveTab=tabObj end)
        tabBtn.Parent=TabBarFrame
        local TabBtnCorner=Instance.new("UICorner")
        TabBtnCorner.CornerRadius=3
        TabBtnCorner.Parent=tabBtn
    end
end

TitleBar.InputBegan:Connect(function(input)
    if input.UserInputType==Enum.UserInputType.MouseButton1 then ImGuiCore.DragActive=UserInputService:GetMouseLocation() end
end)
ResizeHandle.InputBegan:Connect(function(input)
    if input.UserInputType==Enum.UserInputType.MouseButton1 then ImGuiCore.ResizeActive=UserInputService:GetMouseLocation() end
end)
UserInputService.InputChanged:Connect(function(input)
    local mousePos=UserInputService:GetMouseLocation()
    if ImGuiCore.DragActive and input.UserInputType==Enum.UserInputType.MouseMovement then
        local delta=mousePos-ImGuiCore.DragActive
        ImGuiCore.WindowPos=ImGuiCore.WindowPos+UDim2.new(0,delta.X,0,delta.Y)
        WinFrame.Position=ImGuiCore.WindowPos
        ImGuiCore.DragActive=mousePos
    end
    if ImGuiCore.ResizeActive and input.UserInputType==Enum.UserInputType.MouseMovement then
        local delta=mousePos-ImGuiCore.ResizeActive
        local newW=math.max(ImGuiCore.WindowSize.X.Offset+delta.X,ImGuiCore.MinSize.X)
        local newH=math.max(ImGuiCore.WindowSize.Y.Offset+delta.Y,ImGuiCore.MinSize.Y)
        ImGuiCore.WindowSize=UDim2.new(0,newW,0,newH)
        WinFrame.Size=ImGuiCore.WindowSize
        ImGuiCore.ResizeActive=mousePos
    end
end)
UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType==Enum.UserInputType.MouseButton1 then
        ImGuiCore.DragActive=nil
        ImGuiCore.ResizeActive=nil
    end
end)
MinBtn.MouseButton1Click:Connect(function()
    if ImGuiCore.WindowSize.Y.Offset>130 then
        ImGuiCore.WindowSize=UDim2.new(0,420,0,120)
        MinBtn.Text="▼"
    else
        ImGuiCore.WindowSize=UDim2.new(0,540,0,480)
        MinBtn.Text="▲"
    end
    WinFrame.Size=ImGuiCore.WindowSize
end)

local TabClass={}
TabClass.__index=TabClass
function TabClass:Button(opt)
    if ImGuiCore.ActiveTab~=self then return end
    CreateNormalButton(opt.Title,opt.Callback)
end
function TabClass:Toggle(opt)
    if ImGuiCore.ActiveTab~=self then return end
    CreateIconToggle(opt.Title,opt.Icon,opt.Value,opt.Callback)
end

Window={}
Tabs={}
function Window:AddTab(tabName)
    local newTab=setmetatable({Title=tabName},TabClass)
    table.insert(ImGuiCore.TabList,newTab)
    return newTab
end

