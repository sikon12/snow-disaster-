local function RenderAllTabButtons()
    TabBarHolder:ClearAllChildren()
    local tabTotal=#ImGuiCore.TabList
    if tabTotal<=0 then return end
    local singleTabUnit=1/tabTotal
    local tabGap=ImGuiCore.TabSpacing
    for tabIndex,tabObj in ipairs(ImGuiCore.TabList) do
        local TabBtn=Instance.new("TextButton")
        TabBtn.Text=tabObj.Title
        TabBtn.Font=ImGuiCore.GlobalFont
        TabBtn.TextSize=ImGuiCore.FontSizeSmall
        TabBtn.Size=UDim2.new(singleTabUnit,-tabGap*2,1,-2)
        TabBtn.Position=UDim2.new((tabIndex-1)*singleTabUnit+tabGap,1,0,1)
        local isActive=ImGuiCore.ActiveTabObj==tabObj
        TabBtn.BackgroundColor3=isActive and Color3.new(ImGuiCore.TabActiveRGB[1],ImGuiCore.TabActiveRGB[2],ImGuiCore.TabActiveRGB[3]) or Color3.new(ImGuiCore.TabIdleRGB[1],ImGuiCore.TabIdleRGB[2],ImGuiCore.TabIdleRGB[3])
        TabBtn.TextColor3=Color3.new(1,1,1)
        TabBtn.AutoLocalize=false
        TabBtn.MouseButton1Click:Connect(function()
            ImGuiCore.ActiveTabObj=tabObj
            AddLogLine("[Tab] Switched to "..tabObj.Title)
        end)
        local TabBtnCorner=Instance.new("UICorner")
        TabBtn.CornerRadius=ImGuiCore.TabCornerRadius
        TabBtn.Parent=TabBtn
        local TabHover=TweenService:Create(TabBtn,TweenInfo.new(ImGuiCore.TweenSpeed),{BackgroundColor3=Color3.new(math.clamp(ImGuiCore.TabIdleRGB[1]+0.08,0,1),math.clamp(ImGuiCore.TabIdleRGB[2]+0.08,0,1),math.clamp(ImGuiCore.TabIdleRGB[3]+0.08,0,1))})
        local TabIdle=TweenService:Create(TabBtn,TweenInfo.new(ImGuiCore.TweenSpeed),{BackgroundColor3=isActive and Color3.new(ImGuiCore.TabActiveRGB[1],ImGuiCore.TabActiveRGB[2],ImGuiCore.TabActiveRGB[3]) or Color3.new(ImGuiCore.TabIdleRGB[1],ImGuiCore.TabIdleRGB[2],ImGuiCore.TabIdleRGB[3])})
        TabBtn.MouseEnter:Connect(function() TabHover:Play() end)
        TabBtn.MouseLeave:Connect(function() TabIdle:Play() end)
        TabBtn.Parent=TabBarHolder
    end
end

TitleBarContainer.InputBegan:Connect(function(inputObj)
