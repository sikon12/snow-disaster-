UserInputService.InputChanged:Connect(function(inputObj)
    local mousePos=UserInputService:GetMouseLocation()
    if ImGuiCore.DragActive and inputObj.UserInputType==Enum.UserInputType.MouseMovement then
        local deltaVec=mousePos-ImGuiCore.DragMouseOrigin
        ImGuiCore.WindowPos=UDim2.new(ImGuiCore.DragWindowOrigin.X.Scale,ImGuiCore.DragWindowOrigin.X.Offset+deltaVec.X,ImGuiCore.DragWindowOrigin.Y.Scale,ImGuiCore.DragWindowOrigin.Y.Offset+deltaVec.Y)
        MainWindowFrame.Position=ImGuiCore.WindowPos
    end
    if ImGuiCore.ResizeActive and inputObj.UserInputType==Enum.UserInputType.MouseMovement then
        local deltaVec=mousePos-ImGuiCore.ResizeMouseOrigin
        local newW=ImGuiCore.ResizeWindowOrigin.X.Offset+deltaVec.X
        local newH=ImGuiCore.ResizeWindowOrigin.Y.Offset+deltaVec.Y
        newW=math.clamp(newW,ImGuiCore.MinWindowWidth,ImGuiCore.MaxWindowWidth)
        newH=math.clamp(newH,ImGuiCore.MinWindowHeight,ImGuiCore.MaxWindowHeight)
        ImGuiCore.WindowSize=UDim2.new(0,newW,0,newH)
        MainWindowFrame.Size=ImGuiCore.WindowSize
    end
end)
