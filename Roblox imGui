local function AddLogLine(text)
    local splitLog=string.split(ImGuiCore.LogText,"\n")
    table.insert(splitLog,text)
    if #splitLog>ImGuiCore.MaxLogLines then
        table.remove(splitLog,1)
    end
    ImGuiCore.LogText=table.concat(splitLog,"\n")
    LogTextLabel.Text=ImGuiCore.LogText
end

