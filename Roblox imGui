    ImGuiCore.ToggleOffColor={offR,offG,offB}
end

local function RenderImGui()
    if not ImGuiCore.WindowVisible then return end
    ClearCanvas()
    if ImGuiCore.CustomBg then
        WinFrame.BackgroundColor3=Color3.new(ImGuiCore.BgColor[1],ImGuiCore.BgColor[2],ImGuiCore.BgColor[3])
    else
        WinFrame.BackgroundColor3=Color3.new(0.11,0.11,0.13)
    end
    RenderTabBar()
    ScrollContent.CanvasSize=UDim2.new(0,0,0,LayoutY+30)
end
RunService.RenderStepped:Connect(RenderImGui)
