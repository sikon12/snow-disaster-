local function FullImGuiRenderLoop()
    if not ImGuiCore.WindowVisible then return end
    ClearScrollCanvas()
    RenderAllTabButtons()
    local activeTab=ImGuiCore.ActiveTabObj
    if not activeTab then return end
    MainScrollFrame.CanvasSize=UDim2.new(0,0,0,CurrentLayoutY+60)
    WinFrame.BackgroundColor3=Color3.new(ImGuiCore.BgRGB[1],ImGuiCore.BgRGB[2],ImGuiCore.BgRGB[3])
    if ImGuiCore.DrawLog then
        LogContainer.Position=UDim2.new(0,0,1,-124)
    end
