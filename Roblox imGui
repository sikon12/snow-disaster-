local function CreateBaseButton(labelText,clickCallback,tooltipStr,overrideRGB)
    local BtnObj=Instance.new("TextButton")
    BtnObj.Text=labelText
    BtnObj.Font=ImGuiCore.GlobalFont
    BtnObj.TextSize=ImGuiCore.FontSizeBtn
    BtnObj.Size=UDim2.new(1,0,0,24)
    BtnObj.Position=UDim2.new(0,0,0,CurrentLayoutY)
    local baseR,baseG,baseB=ImGuiCore.MainBtnRGB[1],ImGuiCore.MainBtnRGB[2],ImGuiCore.MainBtnRGB[3]
    if overrideRGB then
        baseR,baseG,baseB=overrideRGB[1],overrideRGB[2],overrideRGB[3]
    end
    BtnObj.BackgroundColor3=Color3.new(baseR,baseG,baseB)
    BtnObj.TextColor3=Color3.new(1,1,1)
    BtnObj.AutoLocalize=false
    BtnObj.ZIndex=5
    BtnObj.MouseButton1Click:Connect(clickCallback)
    local BtnCorner=Instance.new("UICorner")
    BtnCorner.CornerRadius=ImGuiCore.WidgetCornerRadius
    BtnCorner.Parent=BtnObj
    local HoverR=math.clamp(baseR+ImGuiCore.HoverBrightenFactor,0,1)
    local HoverG=math.clamp(baseG+ImGuiCore.HoverBrightenFactor,0,1)
    local HoverB=math.clamp(baseB+ImGuiCore.HoverBrightenFactor,0,1)
    local ClickR=math.clamp(baseR-ImGuiCore.ClickDarkenFactor,0,1)
    local ClickG=math.clamp(baseG-ImGuiCore.ClickDarkenFactor,0,1)
    local ClickB=math.clamp(baseB-ImGuiCore.ClickDarkenFactor,0,1)
    local BtnHoverTween=TweenService:Create(BtnObj,TweenInfo.new(ImGuiCore.TweenSpeed),{BackgroundColor3=Color3.new(HoverR,HoverG,HoverB)})
    local BtnClickTween=TweenService:Create(BtnObj,TweenInfo.new(ImGuiCore.TweenSpeed*0.5),{BackgroundColor3=Color3.new(ClickR,ClickG,ClickB)})
    local BtnIdleTween=TweenService:Create(BtnObj,TweenInfo.new(ImGuiCore.TweenSpeed),{BackgroundColor3=Color3.new(baseR,baseG,baseB)})
    BtnObj.MouseEnter:Connect(function() BtnHoverTween:Play() end)
    BtnObj.MouseDown:Connect(function() BtnClickTween:Play() end)
    BtnObj.MouseLeave:Connect(function() BtnIdleTween:Play() end)
    BtnObj.MouseButton1Up:Connect(function() BtnIdleTween:Play() end)
    if tooltipStr and ImGuiCore.TooltipEnabled then
        BtnObj.MouseEnter:Connect(function()
            TooltipLabel.Text=tooltipStr
            TooltipFrame.Visible=true
        end)
        BtnObj.MouseMove:Connect(function(input)
            local mPos=UserInputService:GetMouseLocation()
            TooltipFrame.Position=UDim2.new(0,mPos.X+12,0,mPos.Y+12)
        end)
        BtnObj.MouseLeave:Connect(function()
            TooltipFrame.Visible=false
        end)
    end
    BtnObj.Parent=MainScrollFrame
    CurrentLayoutY=CurrentLayoutY+ImGuiCore.WidgetVerticalSpacing
    return BtnObj
end

local function CreateIconToggle(TitleStr,IconTag,DefaultBool,CallbackFunc,tooltipStr)
    local cacheKey=TitleStr.."_"..IconTag
    if ImGuiCore.WidgetStorage[cacheKey]==nil then
        ImGuiCore.WidgetStorage[cacheKey]=DefaultBool
    end
    local currentState=ImGuiCore.WidgetStorage[cacheKey]
    CreateTextLabel("["..IconTag.."] "..TitleStr.." : "..tostring(currentState),tooltipStr)
    local ToggleBtn=Instance.new("TextButton")
    ToggleBtn.Text=currentState and "开启" or "关闭"
    ToggleBtn.Font=ImGuiCore.GlobalFont
    ToggleBtn.TextSize=ImGuiCore.FontSizeBtn
    ToggleBtn.Size=UDim2.new(1,0,0,24)
    ToggleBtn.Position=UDim2.new(0,0,0,CurrentLayoutY-ImGuiCore.LabelVerticalOffset)
    local rOn,gOn=ImGuiCore.ToggleOnRGB[1],ImGuiCore.ToggleOnRGB[2]
    local bOn=ImGuiCore.ToggleOnRGB[3]
    local rOff,gOff=ImGuiCore.ToggleOffRGB[1],ImGuiCore.ToggleOffRGB[2]
    local bOff=ImGuiCore.ToggleOffRGB[3]
    ToggleBtn.BackgroundColor3=currentState and Color3.new(rOn,gOn,bOn) or Color3.new(rOff,gOff,bOff)
    ToggleBtn.TextColor3=Color3.new(1,1,1)
    ToggleBtn.AutoLocalize=false
    local ToggleCorner=Instance.new("UICorner")
    ToggleCorner.CornerRadius=ImGuiCore.WidgetCornerRadius
    ToggleCorner.Parent=ToggleBtn
    local function RefreshToggleVisual()
        local newVal=ImGuiCore.WidgetStorage[cacheKey]
        ToggleBtn.Text=newVal and "开启" or "关闭"
        ToggleBtn.BackgroundColor3=newVal and Color3.new(rOn,gOn,bOn) or Color3.new(rOff,gOff,bOff)
    end
    ToggleBtn.MouseButton1Click:Connect(function()
        ImGuiCore.WidgetStorage[cacheKey]=not ImGuiCore.WidgetStorage[cacheKey]
        RefreshToggleVisual()
        CallbackFunc(ImGuiCore.WidgetStorage[cacheKey])
    end)
    local HoverOn=TweenService:Create(ToggleBtn,TweenInfo.new(ImGuiCore.TweenSpeed),{BackgroundColor3=Color3.new(math.clamp(rOn+0.1,0,1),math.clamp(gOn+0.1,0,1),math.clamp(bOn+0.1,0,1))})
    local HoverOff=TweenService:Create(ToggleBtn,TweenInfo.new(ImGuiCore.TweenSpeed),{BackgroundColor3=Color3.new(math.clamp(rOff+0.1,0,1),math.clamp(gOff+0.1,0,1),math.clamp(bOff+0.1,0,1))})
    local IdleOn=TweenService:Create(ToggleBtn,TweenInfo.new(ImGuiCore.TweenSpeed),{BackgroundColor3=Color3.new(rOn,gOn,bOn)})
    local IdleOff=TweenService:Create(ToggleBtn,TweenInfo.new(ImGuiCore.TweenSpeed),{BackgroundColor3=Color3.new(rOff,gOff,bOff)})
    ToggleBtn.MouseEnter:Connect(function()
        if ImGuiCore.WidgetStorage[cacheKey] then HoverOn:Play() else HoverOff:Play() end
    end)
    ToggleBtn.MouseLeave:Connect(function()
        if ImGuiCore.WidgetStorage[cacheKey] then IdleOn:Play() else IdleOff:Play() end
    end)
    ToggleBtn.Parent=MainScrollFrame
end

local function CreateCollapseHeader(HeaderName,StorageKey,tooltipStr)
    if ImGuiCore.CollapseState[StorageKey]==nil then
        ImGuiCore.CollapseState[StorageKey]=false
    end
    local state=ImGuiCore.CollapseState[StorageKey]
    local displayText=state and "[+] "..HeaderName or "[-] "..HeaderName
    local CollapseBtn=CreateBaseButton(displayText,function()
        ImGuiCore.CollapseState[StorageKey]=not ImGuiCore.CollapseState[StorageKey]
    end,tooltipStr,{0.14,0.14,0.18})
    return not ImGuiCore.CollapseState[StorageKey]
end

local function CreateSliderControl(LabelText,StorageKey,minVal,maxVal,stepSize,tooltipStr)
    if ImGuiCore.SliderCache[StorageKey]==nil then
        ImGuiCore.SliderCache[StorageKey]=math.clamp((minVal+maxVal)/2,minVal,maxVal)
    end
    local currentNum=ImGuiCore.SliderCache[StorageKey]
    CreateTextLabel(LabelText.." = "..string.format("%.2f",currentNum),tooltipStr)
    CreateBaseButton(LabelText.." +"..stepSize,function()
        ImGuiCore.SliderCache[StorageKey]=math.clamp(ImGuiCore.SliderCache[StorageKey]+stepSize,minVal,maxVal)
    end,"数值增加")
    CreateBaseButton(LabelText.." -"..stepSize,function()
        ImGuiCore.SliderCache[StorageKey]=math.clamp(ImGuiCore.SliderCache[StorageKey]-stepSize,minVal,maxVal)
    end,"数值减少")
end

local function CreateIntSlider(LabelText,StorageKey,min,max,step,tooltipStr)
    if ImGuiCore.IntCache[StorageKey]==nil then
        ImGuiCore.IntCache=math.floor((min+max)/2)
    end
    local val=ImGuiCore.IntCache[StorageKey]
    CreateTextLabel(LabelText.." 整数数值: "..val,tooltipStr)
    CreateBaseButton("+"..step,function()
        ImGuiCore.IntCache[StorageKey]=math.clamp(ImGuiCore.IntCache[StorageKey]+step,min,max)
    end)
    CreateBaseButton("-"..step,function()
        ImGuiCore.IntCache[StorageKey]=math.clamp(ImGuiCore.IntCache[StorageKey]-step,min,max)
    end)
end

