ImGui = {}

-- Tab API: Create/Rename/Delete Tabs Externally
function ImGui.BeginTabBar() DrawTabBar() end
function ImGui.BeginTabItem(tabName)
    -- Return tab index if exists, else create new tab
    local idx = nil
    for i,t in ipairs(ImGuiIO.Tabs) do
        if t.Name == tabName then idx = i break end
    end
    if not idx then
        table.insert(ImGuiIO.Tabs, {Name = tabName, Open = true})
        idx = #ImGuiIO.Tabs
    end
    ImGuiIO.ActiveTabIndex = idx
    return idx
end
function ImGui.RenameTab(oldName,newName)
    for _,t in ipairs(ImGuiIO.Tabs) do
        if t.Name == oldName then t.Name = newName break end
    end
end
function ImGui.RemoveTab(tabName)
    for i,t in ipairs(ImGuiIO.Tabs) do
        if t.Name == tabName then table.remove(ImGuiIO.Tabs,i) break end
    end
end

-- Widget API (WindUI simple chain usage)
function ImGui.Text(text) AddLabel(text) end
function ImGui.Button(label,callback) AddButton(label,callback) end
function ImGui.Checkbox(label,bindKey)
    local val = ImGuiIO.Values[bindKey]
    AddLabel(label..": "..tostring(val))
    AddButton(val and "ON" or "OFF", function() ImGuiIO.Values[bindKey] = not ImGuiIO.Values[bindKey] end)
end
function ImGui.SliderFloat(label,bindKey,min,max,step)
    local v = ImGuiIO.Values[bindKey]
    AddLabel(label..": "..v)
    AddButton(label.." +"..step, function() ImGuiIO.Values[bindKey] = math.clamp(v+step,min,max) end)
    AddButton(label.." -"..step, function() ImGuiIO.Values[bindKey] = math.clamp(v-step,min,max) end)
end
function ImGui.InputText(hint,bindKey) AddInput(hint,ImGuiIO.Values,bindKey) end
function ImGui.Combo(label,bindKey,optionsTable)
    local sel = ImGuiIO.Values[bindKey]
    AddLabel(label.." Selected: "..optionsTable[sel])
    for i,opt in ipairs(optionsTable) do
        AddButton("Select "..opt, function() ImGuiIO.Values[bindKey] = i end)
    end
end
function ImGui.CollapsingHeader(label,bindKey)
    local c = ImGuiIO.Values[bindKey]
    AddButton(c and "[+] "..label or "[-] "..label, function() ImGuiIO.Values[bindKey] = not c end)
    return not c
end
function ImGui.ColorEdit3(label)
    AddLabel(label.." R: "..string.format("%.2f",ImGuiIO.BgColor[1]))
    AddButton("R +0.05",function() ImGuiIO.BgColor[1]=math.clamp(ImGuiIO.BgColor[1]+0.05,0,1) end)
    AddButton("R -0.05",function() ImGuiIO.BgColor[1]=math.clamp(ImGuiIO.BgColor[1]-0.05,0,1) end)
    AddLabel(label.." G: "..string.format("%.2f",ImGuiIO.BgColor[2]))
    AddButton("G +0.05",function() ImGuiIO.BgColor[2]=math.clamp(ImGuiIO.BgColor[2]+0.05,0,1) end)
    AddButton("G -0.05",function() ImGuiIO.BgColor[2]=math.clamp(ImGuiIO.BgColor[2]-0.05,0,1) end)
    AddLabel(label.." B: "..string.format("%.2f",ImGuiIO.BgColor[3]))
    AddButton("B +0.05",function() ImGuiIO.BgColor[3]=math.clamp(ImGuiIO.BgColor[3]+0.05,0,1) end)
    AddButton("B -0.05",function() ImGuiIO.BgColor[3]=math.clamp(ImGuiIO.BgColor[3]-0.05,0,1) end)
    AddButton("Toggle Custom Background",function() ImGuiIO.CustomBg = not ImGuiIO.CustomBg end)
end
-- Script Loader API
function ImGui.LoadRemoteScript(urlKey)
    local url = ImGuiIO.Values[urlKey]
    if url == "" then warn("[ImGui] URL empty") return end
    task.spawn(function()
        local ok,src = pcall(HttpService.GetAsync,HttpService,url)
        if ok then ImGuiIO.Values.ScriptCache = src print("[ImGui] Remote script loaded") else warn("[ImGui] Load fail: "..src) end
    end)
end
function ImGui.RunScriptCache()
    local code = ImGuiIO.Values.ScriptCache
    if #code < 4 then warn("[ImGui] Script empty") return end
    local ok,err = pcall(loadstring(code))
    if not ok then warn("[ImGui] Script error: "..err) else print("[ImGui] Script executed") end
end

-- Main Render Loop (Immediate Mode same as original ImGui)
local function RenderImGui()
    if not ImGuiIO.WindowVisible then return end
    ClearContent()
    -- Sync background color realtime
    if ImGuiIO.CustomBg then WinFrame.BackgroundColor3 = Color3.new(ImGuiIO.BgColor[1],ImGuiIO.BgColor[2],ImGuiIO.BgColor[3]) else WinFrame.BackgroundColor3 = Color3.new(0.11,0.11,0.13) end
    ImGui.BeginTabBar()
    local activeTabData = ImGuiIO.Tabs[ImGuiIO.ActiveTabIndex]
    if not activeTabData then return end
    -- Render tab content (you can overwrite this block OR call ImGui functions externally)
    local tabName = activeTabData.Name
    if tabName == "Main" then
        ImGui.Text("==== Standard ImGui Widgets ====")
        local openSection = ImGui.CollapsingHeader("Control Group","SectionCollapsed")
        if openSection then
            ImGui.Checkbox("Global Toggle","ToggleBool")
            ImGui.SliderFloat("Value Slider","SliderNum",0,100,5)
            ImGui.Combo("Dropdown Select","DropdownSel",ImGuiIO.Values.DropdownOpts)
            ImGui.InputText("Type Text Here","InputStr")
            ImGui.Button("Test Action Button",function() print("[ImGui] Button pressed") end)
        end
    elseif tabName == "Script Loader" then
        ImGui.Text("==== External Lua Script Loader ====")
        ImGui.InputText("Remote Raw URL","RemoteUrl")
        ImGui.Button("Fetch Remote Script",function() ImGui.LoadRemoteScript("RemoteUrl") end)
        ImGui.InputText("Paste Script Code","ScriptCache")
        ImGui.Button("Run External Script",function() ImGui.RunScriptCache() end)
    elseif tabName == "Color Editor" then
        ImGui.ColorEdit3("Window Background Color")
        ImGui.Button("Reset Default Dark BG",function() ImGuiIO.BgColor = {0.11,0.11,0.13} end)
    end
    ScrollContent.CanvasSize = UDim2.new(0,0,0,LayoutY+30)
end

RunService.RenderStepped:Connect(RenderImGui)

